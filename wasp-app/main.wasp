app PauseAndEffect {
  wasp: {
    version: "^0.22.0"
  },
  title: "Pause & Effect",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  auth: {
    userEntity: User,
    methods: {
      usernameAndPassword: {},
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/deck",
  },
  server: {
    setupFn: import { setup } from "@src/server/setup",
    middlewareConfigFn: import { serverMiddleware } from "@src/server/setup",
  },
  db: {
    seeds: [
      import { seedDemoCache } from "@src/server/seed",
    ],
  },
}

// ---------- Pages ----------

route RootRoute { path: "/", to: MainPage }
page MainPage {
  component: import { MainPage } from "@src/client/MainPage"
}

route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import { LoginPage } from "@src/client/auth/AuthPages"
}

route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import { SignupPage } from "@src/client/auth/AuthPages"
}

// Study program (Task 7)
route DeckRoute { path: "/deck", to: DeckPage }
page DeckPage {
  component: import { DeckPage } from "@src/client/DeckPage"
}

route PracticeRoute { path: "/practice", to: PracticePage }
page PracticePage {
  component: import { PracticePage } from "@src/client/PracticePage"
}

// ---------- Extension API (called only from the extension's background worker) ----------
// All ext* routes: POST + JSON, auth: false, guarded by the x-demo-key header.

api extPing {
  fn: import { extPing } from "@src/server/ping",
  httpRoute: (POST, "/ext/ping"),
  auth: false
}

// Task 1: { videoId, title } → { status, segments, hasDialogue }; starts ingest on first call
api extSession {
  fn: import { extSession } from "@src/server/ingest",
  httpRoute: (POST, "/ext/session"),
  entities: [Video],
  auth: false
}

// Task 4: { videoId, t, captionLines } → Explanation
api extExplain {
  fn: import { extExplain } from "@src/server/explain",
  httpRoute: (POST, "/ext/explain"),
  entities: [Moment, Video, User],
  auth: false
}

// Task 6: { videoId, segmentId, audioBase64, durationSec } → ShadowResult
api extShadow {
  fn: import { extShadow } from "@src/server/shadow",
  httpRoute: (POST, "/ext/shadow"),
  entities: [ShadowAttempt, Video, User],
  auth: false
}

// ---------- Study program operations (Task 7) ----------

query getDeck {
  fn: import { getDeck } from "@src/server/deck",
  entities: [Moment, ShadowAttempt, Video, User]
}

action submitShadow {
  fn: import { submitShadow } from "@src/server/deck",
  entities: [ShadowAttempt, Video, User]
}
