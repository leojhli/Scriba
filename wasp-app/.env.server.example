# Copy to .env.server (gitignored) and fill in.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# Must match DEMO_KEY in extension/src/shared/config.ts
DEMO_KEY=pause-and-effect-demo
# Optional: Azure Speech pronunciation assessment for shadowing (per-word and per-sound scores).
# Without these, shadowing is scored with Scribe + the word diff, as before. Use the Free F0 tier.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: a resource endpoint (https://<name>.cognitiveservices.azure.com) instead of the region,
# and a locale for videos whose language is unknown, or a variant (e.g. es-MX instead of es-ES).
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LOCALE=
