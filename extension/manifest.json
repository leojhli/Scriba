{
  "manifest_version": 3,
  "name": "Pause & Effect",
  "version": "0.2.0",
  "description": "You just watch. It builds your study program.",
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "Pause & Effect"
  }
}
